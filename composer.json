{
  "name": "kumwe/record-values",
  "description": "Portable bounded record values, exact numeric normalization and temporal semantics.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/record-values",
  "require": {
    "php": "^8.5",
    "php-64bit": "*",
    "ext-json": "*",
    "kumwe/conversion": "0.1.5",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0 || ^13.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Record\\Value\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Record\\Value\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "manifests": "php tools/manifests.php",
    "check": [
      "composer validate --strict",
      "@schemas",
      "@dependencies:check",
      "@lint",
      "@architecture",
      "@test",
      "@analyse",
      "@cs",
      "@manifests",
      "@governance",
      "@security:audit",
      "@release:check",
      "@clean-consumer"
    ],
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "security:audit": "composer audit --abandoned=fail",
    "architecture": "php tools/architecture.php",
    "release:check": [
      "bash tools/test-release-record.sh",
      "bash tools/test-release-integrity.sh",
      "bash tools/test-release-on-record.sh",
      "bash tools/test-configure-release-repositories.sh",
      "bash tools/test-release-dependencies.sh",
      "bash tools/test-package-dependencies.sh"
    ],
    "governance": "php tools/verify-governance.php",
    "dependencies:check": [
      "bash tools/check-dependency-readiness.sh",
      "bash tools/test-dependency-readiness.sh"
    ],
    "schemas": "node tools/schema-validator/verify.cjs"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/tests",
      "/tools",
      "/.github",
      "/composer.local.json",
      "/composer.local.lock",
      "/composer.lock",
      "/phpstan.neon",
      "/phpcs.xml",
      "/phpunit.xml",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/.gitignore",
      "/.gitattributes",
      "/composer.candidate.json",
      "/composer.candidate.lock"
    ]
  }
}
